# Copy to .env and fill in. Never commit .env.

# Bearer token the Crawl4AI container requires on every endpoint.
# Generate with: openssl rand -hex 32
CRAWL4AI_API_TOKEN=

# Host ports. Both are bound to 127.0.0.1 only.
SEARXNG_PORT=8880
CRAWL4AI_PORT=11235

# --- social sources ----------------------------------------------------------
# Everything below is optional and only matters for `deep_search.py --social`.
# A source with no configuration is left out of the social block instead of
# failing.

# Reddit has no free keyword API since self-service access closed, so the
# archive lists these subreddits and filters locally. Comma-separated, no "r/".
# Keyword search across all of Reddit goes through the `web` source instead.
SOCIAL_REDDIT_SUBREDDITS=

# Public Telegram channels, read through t.me/s/<channel>. No login, no phone.
# Comma-separated, no "@".
SOCIAL_TELEGRAM_CHANNELS=

# Mastodon instances whose hashtag timelines to read. Defaults to mastodon.social.
SOCIAL_MASTODON_INSTANCES=

# RSS/Atom feed URLs, comma-separated. This is also how to follow YouTube
# channels without an API key and without spending quota:
# https://www.youtube.com/feeds/videos.xml?channel_id=<channel id>
SOCIAL_RSS_FEEDS=

# Bluesky: a handle and an App Password from Settings -> Privacy and Security.
# Never the account password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# YouTube Data API v3 key. Free quota is 10 000 units/day; one search costs 100.
YOUTUBE_API_KEY=

# --- deep-search skill -------------------------------------------------------
# The skill reads these from the process environment, not from this file — put
# them in your shell rc. The one exception is CRAWL4AI_API_TOKEN above, which
# the skill also reads out of this repo's .env as a fallback.

# Path to this checkout. The skill derives it from its own location, so this is
# only for a copied install, or when the venv and the services live elsewhere.
# DEEP_SEARCH_DIR=

# Branch tavily+jina. Without them the skill runs on searxng+crawl4ai alone.
# TAVILY_API_KEY_1=
# TAVILY_API_KEY_2=
# TAVILY_API_KEY_3=
# JINA_API_KEY=

# Proxy for external requests; localhost never goes through it. Empty value
# means direct. Default: http://127.0.0.1:8118
# DEEP_SEARCH_PROXY=

# Full URLs, when the services are not on the default localhost ports.
# DEEP_SEARCH_SEARXNG_URL=
# DEEP_SEARCH_CRAWL4AI_URL=
